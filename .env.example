# Supabase の接続文字列。portfolio と同じプロジェクトを使い、schema で分ける。
# どちらも Supabase の Connect 画面からコピーできる。[YOUR-PASSWORD] は差し替える。

# 実行時用。transaction モード（ポート 6543）。
# Vercel の関数から直接つなぐと接続数を食い切るため、pooler を通す。
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# マイグレーション用。session モード（ポート 5432）。
# transaction モードでは DDL を流すのに向かないので分けている。
DIRECT_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# admin から記事のキャッシュを落とすための共有 secret。admin 側と同じ値を入れる。
# 未設定なら revalidate は 503 を返す（誰でも落とせる状態にしない）。
REVALIDATE_SECRET=

# 記事に貼ったスライドのリンクをカードにする判定に使う
NEXT_PUBLIC_SLIDES_URL=https://slides.y4bu.net

# OGP の絶対 URL を組むのに使う。未設定なら本番は blog.y4bu.net、
# Vercel のプレビューは VERCEL_URL、手元は localhost:3001 になる。
NEXT_PUBLIC_SITE_URL=

# cookie を 3 サイトで共有するための親ドメイン（本番のみ）。手元では空にする
NEXT_PUBLIC_COOKIE_DOMAIN=.y4bu.net

# 反応の窓口（www）。手元では http://localhost:3000
NEXT_PUBLIC_PORTFOLIO_URL=https://www.y4bu.net
